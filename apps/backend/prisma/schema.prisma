
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")  
}
enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
  LEARNER
}
enum UserStatus {
  ACTIVE
  PENDING
  LOCKED
  REJECTED
}
enum CourseStatus {
  DRAFT      
  PUBLISHED  
  HIDDEN     
}
enum MaterialType {
  TEXT   
  PDF    
}
enum QuestionType {
  MULTIPLE_CHOICE
}
enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String?
  targetScore  Int?       
  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  coursesTaught Course[] @relation("InstructorCourses")
  examAttempts  ExamAttempt[]
  topicMasteries TopicMastery[]

  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  comments       Comment[]
  notifications  Notification[]
  reportsMade    Report[]
  auditLogs      AuditLog[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model Course {
  id           String       @id @default(cuid())
  title        String
  description  String?      @db.Text
  instructorId String
  status       CourseStatus @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  instructor   User          @relation("InstructorCourses", fields: [instructorId], references: [id])
  chapters     Chapter[]
  courseTopics CourseTopic[] 
  prerequisites CoursePrerequisite[] @relation("CoursePrerequisites")
  requiredBy    CoursePrerequisite[] @relation("CourseRequiredBy")

  enrollments   Enrollment[]

  @@index([instructorId])
  @@index([status])
  @@map("courses")
}

model Chapter {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int      
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  lessons Lesson[]

  @@unique([courseId, order])
  @@index([courseId])
  @@map("chapters")
}

model Lesson {
  id        String   @id @default(cuid())
  chapterId String
  title     String
  content   String?  @db.Text
  order     Int      
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter   Chapter    @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  materials Material[]

  progress  LessonProgress[]
  comments  Comment[]

  @@unique([chapterId, order])
  @@index([chapterId])
  @@map("lessons")
}

model Material {
  id        String       @id @default(cuid())
  lessonId  String
  type      MaterialType
  title     String?
  content   String?      @db.Text // type = TEXT
  url       String?               // type = PDF
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@index([lessonId])
  @@index([type])
  @@map("materials")
}

model Topic {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions    Question[]
  courseTopics CourseTopic[]
  attemptTopicResults AttemptTopicResult[]
  masteries    TopicMastery[]
  
  prerequisites   TopicPrerequisite[] @relation("TopicIsDependent")
  dependentTopics TopicPrerequisite[] @relation("TopicIsPrerequisite")
  @@map("topics")
}

model TopicPrerequisite {
  topicId        String
  prerequisiteId String 
  createdAt      DateTime @default(now())

  topic        Topic @relation("TopicIsDependent",    fields: [topicId],        references: [id], onDelete: Restrict)
  prerequisite Topic @relation("TopicIsPrerequisite", fields: [prerequisiteId], references: [id], onDelete: Restrict)

  @@id([topicId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("topic_prerequisites")
}


model CourseTopic {
  courseId  String
  topicId   String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  topic  Topic  @relation(fields: [topicId],  references: [id], onDelete: Restrict)

  @@id([courseId, topicId])
  @@index([topicId])
  @@map("course_topics")
}

model CoursePrerequisite {
  courseId       String
  prerequisiteId String

course Course @relation("CoursePrerequisites",fields: [courseId],references: [id],onDelete: Restrict)
prerequisite Course @relation("CourseRequiredBy",fields: [prerequisiteId],references: [id],onDelete: Restrict)

  @@id([courseId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("course_prerequisites")
}
model Question {
  id          String       @id @default(cuid())
  content     String       @db.Text
  explanation String?      @db.Text 
  type        QuestionType @default(MULTIPLE_CHOICE)
  difficulty  Float        @default(0.0) 
  source      String?     
  license     String?      
  topicId     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  answers     ExamAnswer[]
  topic       Topic            @relation(fields: [topicId], references: [id])
  options     QuestionOption[]
  exams       ExamQuestion[]

  @@index([topicId])
  @@index([topicId, difficulty])
  @@index([type])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  content    String  @db.Text
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([questionId])
  @@map("question_options")
}

model Exam {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attempts     ExamAttempt[]
  questions   ExamQuestion[]

  @@map("exams")
}

model ExamQuestion {
  examId     String
  questionId String

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Restrict)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([examId, questionId])
  @@map("exam_questions")
}

model ExamAttempt {
  id          String   @id @default(cuid())
  userId      String?  
  examId      String?
  status      AttemptStatus  @default(IN_PROGRESS)

  startedAt     DateTime      @default(now())
  deadlineAt    DateTime?
  submittedAt   DateTime?
  timeLimit     Int?

  score       Float    @default(0)
  weightedScore Float  @default(0)
  total       Int      @default(0)

  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  exam    Exam?         @relation(fields: [examId], references: [id], onDelete: Restrict)
  answers ExamAnswer[]
  topicResults AttemptTopicResult[]

  @@index([status, deadlineAt])
  @@index([userId, status, submittedAt])
  @@map("exam_attempts")
}

model ExamAnswer {
  id                String   @id @default(cuid())
  attemptId         String
  questionId        String
  isCorrect         Boolean   @default(false)
  timeSpent         Int       @default(0) 

  selectedOptionIds String[] 

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  @@unique([attemptId, questionId])
  @@map("exam_answers")
}

model AttemptTopicResult {
  id            String   @id @default(cuid())
  attemptId     String
  topicId       String
  correct       Int      @default(0)
  total         Int      @default(0)
  weightedScore Float    @default(0)
  timeSpent     Int      @default(0)
  createdAt     DateTime @default(now())

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  topic   Topic       @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@unique([attemptId, topicId])
  @@index([attemptId])
  @@index([topicId])
  @@map("attempt_topic_results")
}

model TopicMastery {
  id        String   @id @default(cuid())
  userId    String
  topicId   String
  rating    Float    @default(1200)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@unique([userId, topicId])
  @@index([userId])
  @@index([topicId])
  @@map("topic_masteries")
}

// Bảng Ghi danh khóa học
model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

// Bảng Tiến độ học tập từng bài
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

// Bảng Bình luận / Thảo luận bài học
model Comment {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("comments")
}

// Bảng Thông báo cho người dùng
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// Bảng Báo cáo vi phạm (Dành cho Admin duyệt)
model Report {
  id          String   @id @default(cuid())
  reporterId  String
  targetId    String   // ID của nội dung bị report (VD: ID của Comment, Course)
  targetType  String   // Loại nội dung (VD: "COMMENT", "COURSE")
  reason      String   @db.Text
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Restrict)

  @@map("reports")
}

// Bảng Nhật ký thao tác quản trị viên
model AuditLog {
  id          String   @id @default(cuid())
  adminId     String?
  action      String   // Thao tác (VD: "APPROVE_INSTRUCTOR", "LOCK_USER")
  details     String?  @db.Text
  createdAt   DateTime @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}