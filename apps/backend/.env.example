DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/app_db?schema=public"
JWT_SECRET="replace-with-a-random-secret-before-deploying"
JWT_EXPIRES_IN="1d"
REDIS_HOST="localhost"
REDIS_PORT=6379

# Optional PostgreSQL client binary directory (pg_dump, pg_restore, psql).
# PG_BIN="C:/Program Files/PostgreSQL/18/bin"
# TEST_DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/postgres"
# RESTORE_DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/restore_check"

# Required by npm run seed:production. Keep real values outside version control.
# SEED_ADMIN_EMAIL="admin@your-domain.vn"
# SEED_ADMIN_PASSWORD=""
# SEED_INSTRUCTOR_EMAIL="instructor@your-domain.vn"
# SEED_INSTRUCTOR_PASSWORD=""
# SEED_STUDENT_EMAIL="student@your-domain.vn"
# SEED_STUDENT_PASSWORD=""
# SEED_BACKUP_DIR="backups"
